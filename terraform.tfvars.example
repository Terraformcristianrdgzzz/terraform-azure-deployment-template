vm_name                   = "vm-web-demo"
admin_username            = "azureuser"
admin_ssh_public_key      = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY azure-webserver"
ssh_source_address_prefix = null
os_disk_size_gb           = 30
